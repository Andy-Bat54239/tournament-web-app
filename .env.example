# Copy to .env.local. Nothing here is needed for local development: the defaults work.

# The tournament this app runs. ISO time with an East Africa Time offset.
TOURNAMENT_START=2026-11-01T14:00:00+03:00
# Number of spots, 2 to 64.
TOURNAMENT_CAP=64

# Lichess username of the super admin (Joel). Defaults to "Joel" outside production.
# In production there is no super admin until this is set.
SUPER_ADMIN=Joel

# Demo players and demo admins (Ruth_Ref, Dan_Desk). On outside production, off in production.
SEED_DEMO=true

# Which Lichess to talk to. Leave unset for the mock, which invents ratings and lets you simulate games by hand.
# "live" uses the real Lichess to create game links and read results (login is still the mock).
LICHESS_MODE=
# Needed when LICHESS_MODE=live: a personal access token with the challenge:read and challenge:write scopes,
# for the account that creates the game links. Create it at https://lichess.org/account/oauth/token/create
LICHESS_SERVICE_TOKEN=

# How people log in. "oauth" is the real Log in with Lichess; "mock" is a stand-in where any username can be typed
# (development and demos only). Unset: the real Lichess (LICHESS_MODE=live) means oauth, anything else means mock.
LICHESS_LOGIN=
# The name Lichess shows for this app on its permission page. Nothing is registered anywhere under it.
LICHESS_CLIENT_ID=castle-connect-ug
# The public address of the app, with no path. Lichess sends people back here after they log in.
# Needed (and must be https) in production. In development it is worked out from the address you use.
APP_URL=

# Where the tournament is kept. Leave unset in development: a local PGlite database in .data/pglite is used, and
# data survives restarts. Required in production, for example the connection string from Neon.
# Neon's string ends in sslmode=require, which works but makes the pg driver print a warning. Writing
# sslmode=verify-full instead means the same thing and is quiet. Tried against Neon (pooled, Frankfurt) on 2026-10-26.
DATABASE_URL=
# Optional: a different folder for the local database, or a bigger pool (default 5) for pg.
PGLITE_DIR=
DATABASE_POOL_MAX=

# TOURNAMENT_START, TOURNAMENT_CAP and SEED_DEMO above only apply the first time the app runs on an empty database.

# Reading results from Lichess for games nobody has open. Pick one (see the README, "The Swiss and the results"):
# On a server that stays up: read by itself every SYNC_EVERY_SECONDS (20 unless set, never under 5).
BACKGROUND_SYNC=
SYNC_EVERY_SECONDS=
# On any host: something calls GET /api/sync every minute with "Authorization: Bearer <this>". Use a long random
# string, for example: openssl rand -base64 32. Until it is set, /api/sync refuses everyone.
CRON_SECRET=

# --- Production only ---
# Signs the session cookie. Required. Use a long random string, for example: openssl rand -base64 48
SESSION_SECRET=
# The stand-in login lets anyone log in as anyone, the super admin included.
# It is refused in production unless this is "true". Leave it unset for a real event.
ALLOW_MOCK_LOGIN=
