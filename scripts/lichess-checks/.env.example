# Copy to .env.local in this folder and fill in. .env.local is git-ignored.
# Personal access tokens for three throwaway Lichess test accounts. Do not paste them anywhere else.
# Each token needs exactly these scopes:
#   challenge:read, challenge:write, board:play, team:write, tournament:write
# Create them at https://lichess.org/account/oauth/token/create
LICHESS_A_TOKEN=
LICHESS_B_TOKEN=
